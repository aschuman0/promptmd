{
  "name": "promptmd",
  "displayName": "PromptMD",
  "description": "Custom editor for *prompt*.py files: WYSIWYG edit of triple-quoted Markdown strings with f-string placeholder highlighting.",
  "version": "0.1.0",
  "publisher": "promptmd",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:promptmd.promptEditor",
    "onCustomEditor:promptmd.markdownEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "promptmd.promptEditor",
        "displayName": "Prompt Editor",
        "selector": [
          {
            "filenamePattern": "*prompt*.py"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "promptmd.markdownEditor",
        "displayName": "Markdown Editor (PromptMD)",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "esbuild webview/editor.ts --bundle --format=iife --outfile=media/editor.js --minify",
    "build:webview:watch": "esbuild webview/editor.ts --bundle --format=iife --outfile=media/editor.js --watch",
    "dev": "concurrently -n ts,webview \"npm run watch\" \"npm run build:webview:watch\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "@tiptap/core": "^3.19.0",
    "@tiptap/markdown": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aschuman0/promptmd.git"
  }
}